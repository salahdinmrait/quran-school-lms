# ── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Get these from https://neon.tech → your project → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="change-this-to-a-random-64-char-string"
NEXTAUTH_URL="https://your-app.vercel.app"

# ── Email (optional — notificaties werken via console.log als niet ingesteld) ─
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your@gmail.com"
# SMTP_PASS="app-password"
# SMTP_FROM="Jadwal LMS <your@gmail.com>"
