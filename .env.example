# ── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Get these from https://neon.tech → your project → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="change-this-to-a-random-64-char-string"
NEXTAUTH_URL="https://your-app.vercel.app"

# ── Email (optional — notificaties werken via console.log als niet ingesteld) ─
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your@gmail.com"
# SMTP_PASS="app-password"
# SMTP_FROM="Jadwal LMS <your@gmail.com>"

# ── Bijlage-opslag (Backblaze B2, S3-compatibel) ─────────────────────────────
# Bucket privé houden: up- en downloads lopen via kortlevende presigned URL's.
B2_BUCKET="jadwal-bijlagen"
B2_ENDPOINT="s3.eu-central-003.backblazeb2.com"
B2_KEY_ID="your-key-id"
B2_APP_KEY="your-application-key"

# ── Back-upopslag (B2, bewust een ANDERE bucket dan de bijlagen) ─────────────
# Aparte bucket met een eigen, daarop gescopete sleutel: een gebruiker kan dan
# nooit via een eigen bijlage-rij naar een back-up wijzen. Endpoint is gedeeld.
B2_BACKUP_BUCKET="jadwal-backups"
B2_BACKUP_KEY_ID="your-backup-key-id"
B2_BACKUP_APP_KEY="your-backup-application-key"
# Waarschuwingsgrens voor het totale opslaggebruik in GB (standaard 400).
# B2_WAARSCHUW_GB="400"
